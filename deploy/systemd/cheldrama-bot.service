[Unit]
Description=Chelyabinsk Drama Theatre Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botadmin
Group=botadmin
WorkingDirectory=/opt/cheldrama-bot
EnvironmentFile=-/etc/cheldrama-bot/runtime.env
Environment=THEATRE_BOT_HOST=127.0.0.1
Environment=THEATRE_BOT_PORT=8080
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/cheldrama-bot/.venv/bin/python /opt/cheldrama-bot/scripts/run_web.py
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
