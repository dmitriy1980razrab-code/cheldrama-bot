[Unit]
Description=Prepare Cheldrama service notifications for persistent delivery
After=cheldrama-bot.service

[Service]
Type=oneshot
User=botadmin
Group=botadmin
WorkingDirectory=/opt/cheldrama-bot
EnvironmentFile=/etc/cheldrama-bot/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/cheldrama-bot/.venv/bin/python /opt/cheldrama-bot/scripts/prepare_service_notifications.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cheldrama-bot/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=256M
TasksMax=16
TimeoutStartSec=120
