# Этот файл содержит только пути и несекретный ID. Реальные значения хранятся
# отдельными файлами в /etc/cheldrama-bot/secrets и не добавляются в Git.
THEATRE_SUBSCRIBER_ENCRYPTION_KEY_FILE=/etc/cheldrama-bot/secrets/subscriber-encryption.key
THEATRE_SUBSCRIBER_HASH_KEY_FILE=/etc/cheldrama-bot/secrets/subscriber-hash.key
THEATRE_VK_CALLBACK_SECRET_FILE=/etc/cheldrama-bot/secrets/vk-callback-secret
THEATRE_VK_CONFIRMATION_CODE_FILE=/etc/cheldrama-bot/secrets/vk-confirmation-code
THEATRE_VK_ACCESS_TOKEN_FILE=/etc/cheldrama-bot/secrets/vk-access-token
THEATRE_VK_GROUP_ID=

# MAX подключается отдельно после получения официальных параметров.
# THEATRE_MAX_WEBHOOK_SECRET_FILE=/etc/cheldrama-bot/secrets/max-webhook-secret
# THEATRE_MAX_ACCESS_TOKEN_FILE=/etc/cheldrama-bot/secrets/max-access-token
