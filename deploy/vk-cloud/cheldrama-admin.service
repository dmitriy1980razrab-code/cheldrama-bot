[Unit]
Description=Cheldrama private staff panel
After=network.target

[Service]
User=botadmin
Group=botadmin
UMask=0077
WorkingDirectory=/opt/cheldrama-bot
EnvironmentFile=-/etc/cheldrama-bot/runtime.env
ExecStart=/opt/cheldrama-bot/.venv/bin/python /opt/cheldrama-bot/scripts/run_admin.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cheldrama-bot/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
