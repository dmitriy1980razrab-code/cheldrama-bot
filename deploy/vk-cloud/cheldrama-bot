server {
    listen 80;
    listen [::]:80;
    server_name vash-kapeldiner.ru www.vash-kapeldiner.ru;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name vash-kapeldiner.ru www.vash-kapeldiner.ru;

    ssl_certificate /etc/letsencrypt/live/vash-kapeldiner.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vash-kapeldiner.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 16k;
    limit_req_status 429;
    limit_conn_status 429;
    limit_conn cheldrama_per_ip 10;
    limit_conn cheldrama_total 32;
    access_log off;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 15s;
    proxy_read_timeout 30s;
    proxy_request_buffering on;

    location = /api/chat {
        limit_req zone=cheldrama_chat burst=5 nodelay;
        limit_except POST {
            deny all;
        }
        proxy_pass http://127.0.0.1:8080;
    }

    location = /webhooks/vk {
        limit_except POST {
            deny all;
        }
        proxy_pass http://127.0.0.1:8080;
    }

    location = /webhooks/max {
        limit_except POST {
            deny all;
        }
        proxy_pass http://127.0.0.1:8080;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
    }
}
